# ============================================================================
# Lista de Mercado da Família — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os dados do SEU projeto Firebase.
#   cp .env.example .env
#
# ATENÇÃO: estas chaves do Firebase Web NÃO são secretas — elas vão para dentro
# do JavaScript que o navegador baixa, e isso é normal e documentado pelo Google.
# Quem realmente protege a sua lista são as `firestore.rules` e o App Check.
# Nunca coloque aqui chaves de SERVIÇO (service account) ou segredos de servidor.
# ============================================================================

# --- Firebase (Console → Configurações do projeto → Seus apps → Configuração) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- App Check (Console → App Check → Apps → reCAPTCHA v3) ---
# Chave DO SITE do reCAPTCHA v3. Deixe vazio para rodar sem App Check (só em dev).
VITE_APPCHECK_RECAPTCHA_KEY=

# Token de depuração do App Check. Use SOMENTE em desenvolvimento, e registre-o
# em Console → App Check → Apps → ⋮ → Gerenciar tokens de depuração.
VITE_APPCHECK_DEBUG_TOKEN=

# --- Emuladores (apenas desenvolvimento/testes; deixe vazio em produção) ---
# VITE_FIRESTORE_EMULATOR=127.0.0.1:8080
# VITE_AUTH_EMULATOR=127.0.0.1:9099
VITE_FIRESTORE_EMULATOR=
VITE_AUTH_EMULATOR=

# --- Opcional: notificações push via FCM ---
# Exige Cloud Functions, que exige o plano Blaze (pago, com cota gratuita).
# Deixe `false` para o app funcionar 100% no plano gratuito (Spark).
VITE_PUSH_ENABLED=false
# Chave VAPID (Console → Configurações do projeto → Cloud Messaging → Web Push)
VITE_FIREBASE_VAPID_KEY=

# --- Informativo ---
VITE_APP_VERSION=1.0.0
